<Application x:Class="CarPartManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CarPartManager"
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             xmlns:views="clr-namespace:CarPartManager.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- محول عام للرؤية من منطقي إلى مرئي/مخفي -->
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <!-- ربط الـ ViewModels بالـ Views المقابلة لها تلقائياً في نمط MVVM -->
            <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ProductsViewModel}">
                <views:ProductsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:PurchaseInvoicesViewModel}">
                <views:PurchaseInvoicesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:SuppliersViewModel}">
                <views:SuppliersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:SalesInvoicesViewModel}">
                <views:SalesInvoicesView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:SalesInvoicesHistoryViewModel}">
                <views:SalesInvoicesHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:PurchaseInvoicesHistoryViewModel}">
                <views:PurchaseInvoicesHistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:ReturnsViewModel}">
                <views:ReturnsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:CustomersViewModel}">
                <views:CustomersView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewmodels:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
