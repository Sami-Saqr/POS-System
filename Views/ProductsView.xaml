<UserControl x:Class="CarPartManager.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ProductsViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <!-- 1. ترويسة الشاشة والأزرار العلوية -->
            <RowDefinition Height="Auto" />
            <!-- 2. كروت ملخص المخزون السريعة -->
            <RowDefinition Height="Auto" />
            <!-- 3. شريط البحث والتصفية -->
            <RowDefinition Height="Auto" />
            <!-- 4. جدول قطع الغيار الرئيسي -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. ترويسة الشاشة -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="دليل الأصناف وقطع الغيار" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="إدارة قاعدة بيانات قطع السيارات، تسجيل أرقام OEM، الأسعار، ومراقبة أرصدة المستودع" 
                           FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButtonStyle}" 
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="تحديث القائمة" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding AddProductCommand}"
                        Padding="18,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                              Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="إضافة قطعة جديدة" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. كروت الإحصاءات السريعة للمخزون -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- كرت إجمالي الأصناف -->
            <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي الأصناف المسجلة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} صنف'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#EFF6FF" CornerRadius="8" Width="36" Height="36">
                        <Path Data="M20 7l-8-4-8 4 8 4 8-4zm-8 6l-8-4v8l8 4 8-4v-8l-8 4z" Fill="{StaticResource PrimaryBlueBrush}" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>

            <!-- كرت الأصناف الحرجة وقليلة المخزون -->
            <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="أصناف منخفضة / حرجة" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding LowStockCount, StringFormat='{}{0} قطع'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AlertRedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#FEF2F2" CornerRadius="8" Width="36" Height="36">
                        <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z" Fill="{StaticResource AlertRedBrush}" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>

            <!-- كرت القيمة الإجمالية للمخزون -->
            <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="إجمالي قيمة بضاعة المستودع (شراء)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TotalInventoryValue, StringFormat='{}{0:N2} ج.م'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SalesGreenBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="8" Width="36" Height="36">
                        <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z" Fill="{StaticResource SalesGreenBrush}" Width="18" Height="18" Stretch="Uniform" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. شريط البحث والتصفية السريع -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource BorderBrush}" 
                BorderThickness="1" 
                CornerRadius="10" 
                Padding="16,12" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- مربع البحث -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" 
                          Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" 
                          Fill="{StaticResource TextSecondaryBrush}" 
                          Width="16" Height="16" Stretch="Uniform" 
                          Margin="0,0,10,0" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1" 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource StandardTextBoxStyle}" 
                             BorderThickness="0" 
                             FontSize="13" 
                             VerticalContentAlignment="Center" 
                             Tag="ابحث برقم القطعة OEM، اسم الصنف، الباركود، أو نوع وموديل السيارة..." />

                    <!-- زر مسح البحث -->
                    <Button Grid.Column="2" 
                            Style="{StaticResource OutlineButtonStyle}" 
                            Command="{Binding ClearSearchCommand}"
                            Height="28" Padding="8,0" Margin="6,0,0,0">
                        <TextBlock Text="مسح البحث" FontSize="11" />
                    </Button>
                </Grid>

                <!-- أزرار الإجراءات على الصنف المحدد -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Style="{StaticResource OutlineButtonStyle}" 
                            Command="{Binding EditProductCommand}" 
                            IsEnabled="{Binding HasSelectedProduct}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="تعديل المحدد" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource DangerButtonStyle}" 
                            Command="{Binding DeleteProductCommand}" 
                            IsEnabled="{Binding HasSelectedProduct}"
                            Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                  Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                            <TextBlock Text="حذف" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. جدول قطع الغيار الرئيسي (Products Table) -->
        <Border Grid.Row="3" Style="{StaticResource ContentPanelCardStyle}" Padding="0">
            <Grid>
                <!-- الجدول -->
                <DataGrid Style="{StaticResource CleanDataGridStyle}" 
                          ItemsSource="{Binding FilteredProducts}"
                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                          RowHeight="48" 
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <!-- كود القطعة OEM -->
                        <DataGridTemplateColumn Header="كود OEM" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding PartNumber}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#1E293B" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الباركود -->
                        <DataGridTemplateColumn Header="الباركود" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- اسم الصنف / القطعة -->
                        <DataGridTemplateColumn Header="اسم الصنف / القطعة" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- السيارات المتوافقة -->
                        <DataGridTextColumn Header="السيارات المتوافقة" Binding="{Binding CompatibleVehicles}" Width="1.5*" Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- سعر الشراء / التكلفة -->
                        <DataGridTemplateColumn Header="سعر الشراء" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PurchasePrice, StringFormat='{}{0:N2} ج.م'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- سعر البيع للجمهور -->
                        <DataGridTemplateColumn Header="سعر البيع" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الكمية المتوفرة للبيع -->
                        <DataGridTemplateColumn Header="المتاح للبيع" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity}" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Foreground="{Binding StockStatusColor}" 
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- مخزون التالف -->
                        <DataGridTemplateColumn Header="مخزون التالف" Width="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="4,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DamagedQuantity}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="12" 
                                                   Foreground="#64748B" 
                                                   HorizontalAlignment="Center" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- حد الطلب الأدنى -->
                        <DataGridTemplateColumn Header="حد الطلب" Width="75">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding MinimumStock}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- حالة المخزون -->
                        <DataGridTemplateColumn Header="الحالة" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" Background="#F8FAFC">
                                        <TextBlock Text="{Binding StockStatusText}" FontSize="11" FontWeight="Bold" Foreground="{Binding StockStatusColor}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- عمود الإجراءات السريعة في السطر -->
                        <DataGridTemplateColumn Header="إجراءات" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource TableRowActionButtonStyle}" 
                                                Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="تعديل بيانات هذه القطعة"
                                                Margin="0,0,4,0">
                                            <TextBlock Text="تعديل" />
                                        </Button>
                                        <Button Style="{StaticResource TableRowActionButtonStyle}" 
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#DC2626"
                                                ToolTip="حذف القطعة">
                                            <TextBlock Text="حذف" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- رسالة عند عدم العثور على نتائج في البحث -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding FilteredProducts.Count, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Invert}">
                    <!-- سيتم إظهارها إن كان الجدول فارغاً -->
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
