<Window x:Class="CarPartManager.Views.ProductDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ProductDialogViewModel}"
        Title="{Binding DialogTitle}" 
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Border Background="{StaticResource ContentBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- ترويسة النافذة -->
                <RowDefinition Height="Auto" />
                <!-- نموذج البيانات والمدخلات -->
                <RowDefinition Height="*" />
                <!-- رسالة الخطأ والتحقق -->
                <RowDefinition Height="Auto" />
                <!-- أزرار الإجراءات (حفظ وإلغاء) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. ترويسة النافذة المنبثقة -->
            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <Path Data="M20 7l-8-4-8 4 8 4 8-4zm-8 6l-8-4v8l8 4 8-4v-8l-8 4z"
                              Fill="{StaticResource PrimaryBlueBrush}" Width="20" Height="20" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="يرجى تعبئة بيانات الصنف بدقة للتأكد من صحة الجرد والأسعار" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. نموذج بيانات الصنف (Form Fields) -->
            <Border Grid.Row="1" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- العمود الأيمن -->
                    <StackPanel Grid.Column="0">
                        <!-- كود القطعة OEM -->
                        <TextBlock Text="كود القطعة / رقم OEM *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- اسم الصنف -->
                        <TextBlock Text="اسم الصنف / القطعة *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- تصنيف القطعة -->
                        <TextBlock Text="قسم وتصنيف القطعة" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AvailableCategories}" 
                                  SelectedItem="{Binding Category}"
                                  Height="38" Margin="0,0,0,14"
                                  FontFamily="{StaticResource AppFontFamily}" 
                                  FontSize="13" 
                                  VerticalContentAlignment="Center" />

                        <!-- الكمية الحالية -->
                        <TextBlock Text="الكمية المتوفرة حالياً في المخزن *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- سعر الشراء والتكلفة -->
                        <TextBlock Text="سعر الشراء / التكلفة (ج.م) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,6" />
                    </StackPanel>

                    <!-- العمود الأيسر -->
                    <StackPanel Grid.Column="2">
                        <!-- الباركود المسحي -->
                        <TextBlock Text="الباركود (مسح بالماسح الضوئي)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- السيارات المتوافقة -->
                        <TextBlock Text="ماركة وموديل السيارات المتوافقة" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding CompatibleVehicles, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- حد الطلب الأدنى -->
                        <TextBlock Text="حد الطلب الأدنى (تنبيه النقص) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- سعر البيع للزبون -->
                        <TextBlock Text="سعر البيع للزبون (ج.م) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding SellingPriceText, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,14" />

                        <!-- ملاحظات إضافية -->
                        <TextBlock Text="ملاحظات أو موقع الرف" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 Margin="0,0,0,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. شريط الخطأ والتنبيهات (Validation Error Banner) -->
            <Border Grid.Row="2" 
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}" 
                    Background="#FEF2F2" 
                    BorderBrush="#FCA5A5" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Margin="24,0,24,10" 
                    Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                          Fill="#DC2626" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 4. أزرار الحفظ والإلغاء -->
            <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="24,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="* الحقول الإجبارية مميزة بعلامة النجمة" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineButtonStyle}" 
                                Command="{Binding CancelCommand}" 
                                Content="إلغاء الأمر" 
                                Width="100" 
                                Margin="0,0,10,0" />

                        <Button Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding SaveCommand}" 
                                Content="{Binding SaveButtonText}" 
                                Width="140" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
