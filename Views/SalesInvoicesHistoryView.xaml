<UserControl x:Class="CarPartManager.Views.SalesInvoicesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:SalesInvoicesHistoryViewModel}"
             d:DesignHeight="820" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <!-- ترويسة الصفحة -->
            <RowDefinition Height="Auto" />
            <!-- المحتوى الرئيسي -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ ترويسة الصفحة ═══════════ -->
        <Border Grid.Row="0" Padding="28,20,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="سجل فواتير المبيعات"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="أرشيف جميع فواتير البيع الصادرة — مسودات، معتمدة، وملغاة — مع إمكانية البحث والمعاينة"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="تحديث السجل" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ المحتوى الرئيسي ═══════════ -->
        <Border Grid.Row="1" Margin="28,16,28,24" Style="{StaticResource ContentPanelCardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- شريط البحث والإحصائيات -->
                    <RowDefinition Height="Auto" />
                    <!-- جدول الفواتير -->
                    <RowDefinition Height="*" />
                    <!-- شريط الحالة -->
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- شريط البحث -->
                <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MaxWidth="480" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- حقل البحث -->
                        <Grid Grid.Column="0">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBoxStyle}"
                                     Padding="34,6,10,6"
                                     FontSize="13" />
                            <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- عدد النتائج -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}">
                                    <Run Text="{Binding InvoicesHistory.Count, Mode=OneWay}" />
                                    <Run Text=" فاتورة" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- حالة التحميل -->
                <Border Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="جارٍ تحميل سجل فواتير المبيعات..."
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- حالة فارغة -->
                <Border Grid.Row="1" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisConverter}}"
                        VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"
                              Fill="{StaticResource TextMutedBrush}" Width="52" Height="52" Stretch="Uniform"
                              HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.4" />
                        <TextBlock Text="لا توجد فواتير مبيعات"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="لم يتم إنشاء أي فاتورة مبيعات بعد، أو لا توجد نتائج مطابقة للبحث."
                                   FontSize="13"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- جدول الفواتير -->
                <DataGrid Grid.Row="1"
                          Style="{StaticResource CleanDataGridStyle}"
                          ItemsSource="{Binding InvoicesHistory}"
                          SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          RowHeight="48"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}">
                    <!-- يُخفى الجدول أثناء التحميل ويُظهر الـ Spinner -->
                    <DataGrid.Resources>
                        <Style TargetType="DataGrid" BasedOn="{StaticResource CleanDataGridStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- رقم الفاتورة -->
                        <DataGridTemplateColumn Header="رقم الفاتورة" Width="140" MinWidth="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding InvoiceNumber}"
                                                   FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                   Foreground="{StaticResource PrimaryBlueBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- تاريخ الفاتورة -->
                        <DataGridTemplateColumn Header="التاريخ" Width="95" MinWidth="85">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding InvoiceDate, StringFormat='{}{0:yyyy/MM/dd}'}"
                                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- اسم العميل -->
                        <DataGridTemplateColumn Header="العميل / الورشة" Width="1.6*" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CustomerName}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding CustomerName}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- رقم الهاتف -->
                        <DataGridTemplateColumn Header="الهاتف" Width="110" MinWidth="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding CustomerPhone}"
                                               FontSize="12" FontFamily="Consolas"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- طريقة الدفع -->
                        <DataGridTemplateColumn Header="الدفع" Width="75" MinWidth="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PaymentMethod}" FontSize="10" Foreground="#475569" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الحالة -->
                        <DataGridTemplateColumn Header="الحالة" Width="80" MinWidth="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="معتمدة">
                                                        <Setter Property="Background" Value="#ECFDF5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="مسودة">
                                                        <Setter Property="Background" Value="#FEF3C7" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="ملغاة">
                                                        <Setter Property="Background" Value="#FEF2F2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding StatusColor}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الإجمالي -->
                        <DataGridTemplateColumn Header="الإجمالي" Width="120" MinWidth="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} ج.م'}"
                                               FontWeight="Bold" FontSize="13"
                                               Foreground="{StaticResource SalesGreenBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- عدد الأصناف -->
                        <DataGridTemplateColumn Header="أصناف" Width="65" MinWidth="55">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Items.Count}"
                                               FontSize="12" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ملاحظات -->
                        <DataGridTemplateColumn Header="ملاحظات" Width="1.2*" MinWidth="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Notes}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               ToolTip="{Binding Notes}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- شريط الحالة -->
                <Border Grid.Row="2" Background="#ECFDF5" BorderBrush="#A7F3D0"
                        BorderThickness="0,1,0,0" Padding="20,10">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" FontWeight="SemiBold" Foreground="#065F46" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
