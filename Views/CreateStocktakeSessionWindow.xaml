<Window x:Class="CarPartManager.Views.CreateStocktakeSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="إنشاء جلسة جرد جديدة"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}"
        d:DesignHeight="280">

    <Border Background="{StaticResource ContentBackgroundBrush}" Padding="24,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- اسم الجلسة -->
            <TextBlock Grid.Row="0"
                       Text="اسم الجلسة *"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />

            <TextBox Grid.Row="1"
                     x:Name="NameBox"
                     Style="{StaticResource StandardTextBoxStyle}"
                     Margin="0,0,0,16" />

            <!-- ملاحظات -->
            <TextBlock Grid.Row="2"
                       Text="ملاحظات"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,6" />

            <TextBox Grid.Row="3"
                     x:Name="NotesBox"
                     Style="{StaticResource StandardTextBoxStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,18" />

            <!-- الأزرار -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource OutlineButtonStyle}"
                        Content="إلغاء"
                        Width="100"
                        Margin="0,0,10,0"
                        IsCancel="True" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Content="إنشاء"
                        Width="120"
                        IsDefault="True"
                        Click="Create_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
