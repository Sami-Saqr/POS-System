<UserControl x:Class="CarPartManager.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SuppliersViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <Grid Margin="28,24,28,28">
        <Grid.RowDefinitions>
            <!-- 1. ترويسة الشاشة -->
            <RowDefinition Height="Auto" />
            <!-- 2. المحتوى الرئيسي (جدول الموردين ونموذج الإضافة/التعديل) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. ترويسة الشاشة -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="دليل الموردين وشركات قطع الغيار" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="إدارة بيانات وكلاء الاستيراد والشركات الموردة، وأرقام الهواتف، والعناوين" 
                           FontSize="13" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButtonStyle}" 
                        Command="{Binding RefreshCommand}"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="تحديث البيانات" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. المحتوى: عمودين (الجدول في اليمين، والنموذج في اليسار) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- عمود جدول الموردين والبحث -->
            <Border Grid.Column="0" Style="{StaticResource ContentPanelCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- شريط البحث -->
                        <RowDefinition Height="Auto" />
                        <!-- الجدول -->
                        <RowDefinition Height="*" />
                        <!-- التذييل وإحصائية العدد -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- شريط البحث -->
                    <Border Grid.Row="0" Margin="0,0,0,16" 
                            Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" 
                            BorderThickness="1" CornerRadius="8" Padding="12,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" 
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0" Background="Transparent" 
                                     FontSize="13" VerticalContentAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- جدول الموردين -->
                    <DataGrid Grid.Row="1" 
                              Style="{StaticResource CleanDataGridStyle}"
                              ItemsSource="{Binding FilteredSuppliers}"
                              SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <!-- معرف المورد -->
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="50" />

                            <!-- اسم المورد -->
                            <DataGridTemplateColumn Header="اسم المورد / الوكيل" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding CompanyName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رقم الهاتف -->
                            <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="130" />

                            <!-- العنوان -->
                            <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="160" />

                            <!-- ملاحظات -->
                            <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="140" />

                            <!-- حالة النشاط -->
                            <DataGridTemplateColumn Header="الحالة" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,2" HorizontalAlignment="Center" Background="#DCFCE7">
                                            <TextBlock Text="نشط" FontSize="11" FontWeight="SemiBold" Foreground="#166534" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- تذييل الجدول -->
                    <Border Grid.Row="2" Margin="0,12,0,0" Padding="0,8,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                            <Run Text="إجمالي الموردين بالقائمة: " />
                            <Run Text="{Binding FilteredSuppliers.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- عمود بطاقة النموذج السريع (إضافة / تعديل مورد) -->
            <Border Grid.Column="2" Style="{StaticResource ContentPanelCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- ترويسة بطاقة النموذج -->
                        <Border Margin="0,0,0,16" Padding="0,0,0,12" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="بيانات المورد" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="حدد مورد لتعديله أو أدخل بيانات لإضافته" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource OutlineButtonStyle}" 
                                        Command="{Binding ClearFormCommand}" 
                                        Height="28" Padding="8,0" FontSize="11" Content="تفريغ" />
                            </Grid>
                        </Border>

                        <!-- اسم المورد -->
                        <TextBlock Text="اسم المورد أو المسؤول *" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12" />

                        <!-- اسم الشركة أو التوكيل -->
                        <TextBlock Text="اسم الشركة / المؤسسة التجارية" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding FormCompany, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12" />

                        <!-- رقم الهاتف -->
                        <TextBlock Text="رقم الهاتف للتواصل" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12" />

                        <!-- العنوان -->
                        <TextBlock Text="العنوان أو المقر" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,12" />

                        <!-- الملاحظات -->
                        <TextBlock Text="ملاحظات وتفاصيل التوريد" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Style="{StaticResource StandardTextBoxStyle}" 
                                 Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 Margin="0,0,0,16" />

                        <!-- رسالة الحالة -->
                        <TextBlock Text="{Binding StatusMessage}" 
                                   Foreground="{StaticResource PrimaryBlueBrush}" 
                                   FontSize="12" FontWeight="SemiBold" 
                                   TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- أزرار الإجراءات -->
                        <StackPanel Orientation="Vertical">
                            <Button Style="{StaticResource PrimaryButtonStyle}" 
                                    Command="{Binding SaveSupplierCommand}" 
                                    Height="40" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"
                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="حفظ بيانات المورد" FontWeight="Bold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerButtonStyle}" 
                                    Command="{Binding DeleteSupplierCommand}" 
                                    Height="36">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                                          Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="حذف المورد المحدد" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
