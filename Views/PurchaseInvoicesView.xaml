<UserControl x:Class="CarPartManager.Views.PurchaseInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:PurchaseInvoicesViewModel}"
             d:DesignHeight="850" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,32">

            <!-- 1. ترويسة الشاشة -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="فواتير المشتريات وتوريد البضاعة" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="إدخال فواتير الموردين واعتمادها لتحديث رصيد قطع الغيار — لعرض سجل الفواتير السابقة انتقل لقسم (سجل فواتير المشتريات) من القائمة" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButtonStyle}" 
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="تحديث" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}" 
                            Command="{Binding NewInvoiceCommand}"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                                  Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="فاتورة شراء جديدة" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. جسم الشاشة الرئيسي: محرر فاتورة الشراء فقط -->
            <Grid>

                <!-- ================= محرر فاتورة الشراء ================= -->
                <StackPanel>

                    <!-- كرت بيانات ترويسة الفاتورة والمورد -->
                    <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#EFF6FF" CornerRadius="6" Padding="10,4" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding InvoiceNumber}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" FontFamily="Consolas" />
                                    </Border>
                                    <Border CornerRadius="6" Padding="10,4" Background="#F1F5F9">
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusColor}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="تاريخ الفاتورة:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <DatePicker SelectedDate="{Binding InvoiceDate}" 
                                                IsEnabled="{Binding CanEditInvoice}"
                                                Height="34" Width="140"
                                                VerticalContentAlignment="Center" 
                                                FontFamily="{StaticResource AppFontFamily}" />
                                </StackPanel>
                            </Grid>

                            <!-- اختيار المورد -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="اسم المورد أو الشركة الموردة *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding SuppliersList}" 
                                              SelectedItem="{Binding SelectedSupplier}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding CanEditInvoice}"
                                              Height="38" 
                                              FontFamily="{StaticResource AppFontFamily}" 
                                              FontSize="13" 
                                              VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- كرت إضافة صنف إلى الفاتورة -->
                    <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16" IsEnabled="{Binding CanEditInvoice}">
                        <StackPanel>
                            <TextBlock Text="إضافة صنف من قطع الغيار المسجلة" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- اختيار الصنف -->
                                    <ColumnDefinition Width="2.5*" />
                                    <ColumnDefinition Width="10" />
                                    <!-- الكمية المشتراة -->
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <!-- سعر الشراء للقطعة -->
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="10" />
                                    <!-- زر الإضافة -->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- الصنف -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="قطعة الغيار (كود OEM / الاسم)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding FilteredAvailableProducts}"
                                              SelectedItem="{Binding SelectedProductToAdd}"
                                              Height="38"
                                              VerticalContentAlignment="Center"
                                              FontFamily="{StaticResource AppFontFamily}"
                                              FontSize="12">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding PartNumber}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding CompatibleVehicles, StringFormat='({0})'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- الكمية -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الكمية *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding InputQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource StandardTextBoxStyle}" 
                                             FontWeight="Bold" 
                                             HorizontalContentAlignment="Center" />
                                </StackPanel>

                                <!-- سعر الشراء للوحدة -->
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="سعر الوحدة (ج.م) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding InputUnitPrice, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource StandardTextBoxStyle}" 
                                             FontWeight="Bold" 
                                             HorizontalContentAlignment="Center" />
                                </StackPanel>

                                <!-- زر الإضافة -->
                                <Button Grid.Column="6" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Command="{Binding AddItemCommand}"
                                        Height="38" Padding="14,0" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                        <TextBlock Text="إضافة للفاتورة" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- كرت جدول بنود الفاتورة الحالية -->
                    <Border Style="{StaticResource ContentPanelCardStyle}" Padding="0" Margin="0,0,0,16">
                        <StackPanel>
                            <Border Padding="18,14" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                                <Grid>
                                    <TextBlock Text="أصناف وبنود الفاتورة الحالية" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CurrentInvoiceItems.Count, StringFormat='{}{0} أصناف في الفاتورة'}" 
                                               HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                            </Border>

                            <DataGrid Style="{StaticResource CleanDataGridStyle}" 
                                      ItemsSource="{Binding CurrentInvoiceItems}"
                                      MinHeight="180" MaxHeight="320">
                                <DataGrid.Columns>
                                    <!-- كود OEM -->
                                    <DataGridTemplateColumn Header="كود OEM" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding PartNumber}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- اسم الصنف -->
                                    <DataGridTextColumn Header="اسم الصنف / القطعة" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" />

                                    <!-- الكمية المشتراة -->
                                    <DataGridTemplateColumn Header="الكمية" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Quantity}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- سعر الشراء -->
                                    <DataGridTemplateColumn Header="سعر الشراء" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} ج.م'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- إجمالي البند -->
                                    <DataGridTemplateColumn Header="الإجمالي" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource SalesGreenBrush}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- حذف البند -->
                                    <DataGridTemplateColumn Header="حذف" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource TableRowActionButtonStyle}" 
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Foreground="#DC2626"
                                                        IsEnabled="{Binding DataContext.CanEditInvoice, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <TextBlock Text="✕" FontWeight="Bold" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- شريط إجمالي الفاتورة وأزرار الحفظ والاعتماد -->
                            <Border Background="#F8FAFC" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="20,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- ملاحظات الفاتورة -->
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                        <!-- الإجمالي والأزرار -->
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="ملاحظات اختيارية عن الفاتورة أو الشحنة:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                                 Style="{StaticResource StandardTextBoxStyle}" 
                                                 IsEnabled="{Binding CanEditInvoice}"
                                                 Height="34" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <!-- رقم الإجمالي النهائي -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,12">
                                            <TextBlock Text="إجمالي الفاتورة:" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding TotalInvoiceAmount, StringFormat='{}{0:N2} ج.م'}" 
                                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource SalesGreenBrush}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- أزرار الإجراءات -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource DangerButtonStyle}" 
                                                    Command="{Binding CancelInvoiceCommand}"
                                                    IsEnabled="{Binding CanCancelInvoice}"
                                                    Width="125" 
                                                    Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                                          Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                                    <TextBlock Text="إلغاء الفاتورة" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>

                                            <Button Style="{StaticResource OutlineButtonStyle}" 
                                                    Command="{Binding SaveDraftCommand}"
                                                    IsEnabled="{Binding CanEditInvoice}"
                                                    Content="حفظ كمسودة" 
                                                    Width="110" 
                                                    Margin="0,0,10,0" />

                                            <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                    Command="{Binding PostInvoiceCommand}"
                                                    IsEnabled="{Binding CanEditInvoice}"
                                                    Background="{StaticResource SalesGreenBrush}"
                                                    Width="170">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                                    <TextBlock Text="اعتماد وترحيل للمخزون" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- شريط الحالة (Status Banner) -->
                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" />
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
