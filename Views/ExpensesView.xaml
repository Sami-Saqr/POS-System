<UserControl x:Class="CarPartManager.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:ExpensesViewModel}"
             d:DesignHeight="820" d:DesignWidth="1280"
             FlowDirection="RightToLeft">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════ ترويسة الصفحة ═══════════ -->
        <Border Grid.Row="0" Padding="28,20,28,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="المصروفات"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="تسجيل ومتابعة المصروفات التشغيلية — لا تؤثر على المخزون أو العملاء أو فواتير البيع"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddExpenseCommand}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                  Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="مصروف جديد" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding ToggleCategoryPanelCommand}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3 5h18v2H3V5zm0 6h12v2H3v-2zm0 6h18v2H3v-2z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="إدارة التصنيفات" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="تحديث" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ المحتوى ═══════════ -->
        <Grid Grid.Row="1" Margin="28,16,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- بطاقات الملخص (بدون المصروفات الملغاة) -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- اليوم -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="مصروفات اليوم" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TodayTotalText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TodayTotalText}" />
                    </StackPanel>
                </Border>

                <!-- الشهر الحالي -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="مصروفات الشهر الحالي" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding CurrentMonthTotalText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentMonthTotalText}" />
                        <TextBlock Text="{Binding CurrentMonthCountText}" FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- الشهر السابق -->
                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="مصروفات الشهر السابق" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding PreviousMonthTotalText}" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding PreviousMonthTotalText}" />
                    </StackPanel>
                </Border>

                <!-- أعلى تصنيف -->
                <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                    <StackPanel>
                        <TextBlock Text="أعلى تصنيف (الشهر الحالي)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding TopCategoryText}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource WarningAmberBrush}" Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding TopCategoryText}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- لوحة الجدول والفلاتر -->
            <Border Grid.Row="1" Style="{StaticResource ContentPanelCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ═══ الفلاتر والبحث ═══ -->
                    <Border Grid.Row="0" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="420" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- البحث بالوصف -->
                                <Grid Grid.Column="0">
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StandardTextBoxStyle}"
                                             Padding="34,6,10,6"
                                             FontSize="13"
                                             ToolTip="البحث في وصف المصروف أو الرقم المرجعي" />
                                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                                          Fill="{StaticResource TextMutedBrush}" Width="14" Height="14" Stretch="Uniform"
                                          HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center" />
                                </Grid>

                                <!-- فلتر التصنيف -->
                                <ComboBox Grid.Column="2"
                                          ItemsSource="{Binding CategoryFilters}"
                                          DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCategoryFilter, UpdateSourceTrigger=PropertyChanged}"
                                          Height="38"
                                          FontFamily="{StaticResource AppFontFamily}"
                                          FontSize="13"
                                          VerticalContentAlignment="Center" />

                                <!-- فلتر طريقة الدفع -->
                                <ComboBox Grid.Column="4"
                                          ItemsSource="{Binding PaymentMethodFilters}"
                                          SelectedItem="{Binding SelectedPaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                          Height="38"
                                          FontFamily="{StaticResource AppFontFamily}"
                                          FontSize="13"
                                          VerticalContentAlignment="Center" />
                            </Grid>

                            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="من تاريخ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <DatePicker SelectedDate="{Binding FromDate, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140" Height="34"
                                            FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                                            FlowDirection="RightToLeft" />

                                <TextBlock Text="إلى تاريخ" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="14,0,6,0" />
                                <DatePicker SelectedDate="{Binding ToDate, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140" Height="34"
                                            FontFamily="{StaticResource AppFontFamily}" FontSize="12"
                                            FlowDirection="RightToLeft" />

                                <CheckBox Content="إظهار المصروفات الملغاة"
                                          IsChecked="{Binding IncludeCancelled, UpdateSourceTrigger=PropertyChanged}"
                                          FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                          VerticalAlignment="Center" Margin="16,0,0,0" />

                                <Button Content="مسح الفلاتر"
                                        Command="{Binding ClearFiltersCommand}"
                                        Style="{StaticResource OutlineButtonStyle}"
                                        Height="34" Margin="16,0,0,0" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- ═══ لوحة إدارة التصنيفات ═══ -->
                    <Border Grid.Row="1"
                            Visibility="{Binding IsCategoryPanelOpen, Converter={StaticResource BoolToVisConverter}}"
                            Background="#F8FAFC"
                            BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}"
                            Padding="20,14">
                        <StackPanel>
                            <TextBlock Text="إدارة تصنيفات المصروفات" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="يمكن تعطيل التصنيف أو إعادة تفعيله، ولا يتم حذفه نهائياً أبداً حفاظاً على السجلات — والاسم المكرر (بعد إزالة المسافات الزائدة) غير مسموح."
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBox Width="260"
                                         Text="{Binding NewCategoryName, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource StandardTextBoxStyle}"
                                         ToolTip="اسم التصنيف الجديد" />
                                <Button Content="إضافة تصنيف"
                                        Command="{Binding AddCategoryCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="130" Height="36" Margin="10,0,0,0" />
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,10,10">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               MaxWidth="180" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="{Binding StatusBackground}" CornerRadius="4" Padding="6,1">
                                                            <TextBlock Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"
                                                                       Foreground="{Binding StatusColor}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding UsageText}" FontSize="10"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <Button Content="تعطيل / تفعيل"
                                                        Style="{StaticResource TableRowActionButtonStyle}"
                                                        Margin="12,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ToggleCategoryStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ حالة التحميل ═══ -->
                    <Border Grid.Row="2" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="جارٍ تحميل المصروفات..."
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ الحالة الفارغة ═══ -->
                    <Border Grid.Row="2" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisConverter}}"
                            VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                                  Fill="{StaticResource TextMutedBrush}" Width="52" Height="52" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.4" />
                            <TextBlock Text="لا توجد مصروفات"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="لم يتم تسجيل أي مصروف بعد، أو لا توجد نتائج مطابقة للفلاتر الحالية."
                                       FontSize="13"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ جدول المصروفات ═══ -->
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Expenses}"
                              SelectedItem="{Binding SelectedExpense, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              RowHeight="46"
                              HeadersVisibility="Column"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource CleanDataGridStyle}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <!-- التاريخ -->
                            <DataGridTemplateColumn Header="التاريخ" Width="95" MinWidth="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ExpenseDateText}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- التصنيف -->
                            <DataGridTemplateColumn Header="التصنيف" Width="135" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="7,3"
                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CategoryName}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource PrimaryBlueBrush}"
                                                       MaxWidth="110" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding CategoryName}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الوصف -->
                            <DataGridTemplateColumn Header="الوصف" Width="1.5*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Description}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المبلغ -->
                            <DataGridTemplateColumn Header="المبلغ" Width="115" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AmountText}"
                                                   FontWeight="Bold" FontSize="13"
                                                   Foreground="{StaticResource AlertRedBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- طريقة الدفع -->
                            <DataGridTemplateColumn Header="الدفع" Width="100" MinWidth="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentMethod}" FontSize="10" Foreground="#475569"
                                                       MaxWidth="85" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding PaymentMethod}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- المستخدم -->
                            <DataGridTemplateColumn Header="المستخدم" Width="130" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding UserDisplayName}"
                                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding UserDisplayName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الحالة -->
                            <DataGridTemplateColumn Header="الحالة" Width="85" MinWidth="75">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBackground}" CornerRadius="4" Padding="6,3"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{Binding StatusColor}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- رقم مرجعي -->
                            <DataGridTemplateColumn Header="مرجعي" Width="100" MinWidth="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ReferenceNumber, TargetNullValue='—'}"
                                                   FontSize="11" FontFamily="Consolas"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding ReferenceNumber}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- الإجراءات -->
                            <DataGridTemplateColumn Header="إجراءات" Width="Auto" MinWidth="215">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="تعديل"
                                                    Style="{StaticResource TableRowActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="إلغاء"
                                                    Style="{StaticResource TableRowActionButtonStyle}"
                                                    Margin="0,0,6,0"
                                                    Background="#FEF2F2"
                                                    Foreground="{StaticResource AlertRedBrush}"
                                                    Command="{Binding DataContext.CancelExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="سجل التعديلات"
                                                    Style="{StaticResource TableRowActionButtonStyle}"
                                                    Command="{Binding DataContext.ViewHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ═══ لوحة سجل التدقيق ═══ -->
                    <Border Grid.Row="3"
                            Visibility="{Binding IsHistoryPanelOpen, Converter={StaticResource BoolToVisConverter}}"
                            Background="#F8FAFC"
                            BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                            Padding="20,14">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="سجل التعديلات والإلغاء (تدقيق)" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Button Content="إغلاق"
                                        Style="{StaticResource TableRowActionButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Command="{Binding ToggleHistoryPanelCommand}" />
                            </Grid>

                            <TextBlock Text="لا يوجد أي تعديل أو إلغاء مسجل لهذا المصروف."
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                       Margin="0,10,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ExpenseHistory.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ItemsControl ItemsSource="{Binding ExpenseHistory}" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBackgroundBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding ChangeType}"
                                                           FontSize="12" FontWeight="Bold"
                                                           Foreground="{Binding ChangeTypeColor}"
                                                           VerticalAlignment="Center" />

                                                <TextBlock Grid.Column="1" Text="{Binding ChangedAtText}"
                                                           FontSize="11" FontFamily="Consolas"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" />

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AmountChangeText}" FontSize="11"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding AmountChangeText}" />
                                                    <TextBlock Text="{Binding CategoryChangeText}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding CategoryChangeText}" />
                                                    <TextBlock Text="{Binding Reason}" FontSize="10"
                                                               Foreground="{StaticResource TextMutedBrush}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Reason}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="3" Text="{Binding ChangedByText}"
                                                           FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                           VerticalAlignment="Center" Margin="10,0,0,0"
                                                           MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ChangedByText}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ═══ شريط الحالة ═══ -->
                    <Border Grid.Row="4"
                            Background="{Binding StatusBackground}"
                            BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                            Padding="20,10"
                            Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding StatusForeground}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding StatusMessage}"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{Binding StatusForeground}"
                                       VerticalAlignment="Center" Margin="16,0,0,0">
                                <Run Text="إجمالي النتائج:" />
                                <Run Text="{Binding FilteredTotalText, Mode=OneWay}" />
                                <Run Text="—" />
                                <Run Text="{Binding FilteredCountText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
