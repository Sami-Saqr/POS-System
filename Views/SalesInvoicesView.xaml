<UserControl x:Class="CarPartManager.Views.SalesInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:SalesInvoicesViewModel}"
             d:DesignHeight="880" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <Grid Margin="24,14,24,14">
        <Grid.RowDefinitions>
            <!-- 0. ترويسة الشاشة -->
            <RowDefinition Height="Auto" />
            <!-- 1. كروت بيانات العميل وإضافة الصنف (شريط الباركود والإضافة اليدوية) -->
            <RowDefinition Height="Auto" />
            <!-- 2. المساحة المهيمنة الكبرى: جدول بنود الفاتورة الحالية -->
            <RowDefinition Height="*" MinHeight="180" />
            <!-- 3. الشريط السفلي الثابت: الملاحظات، المبالغ، الإجماليات، الأزرار، وشريط الحالة -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. ترويسة الشاشة (نقطة البيع - الكاشير وأزرار التحديث وفاتورة جديدة) -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="نقطة البيع (الكاشير)" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="إصدار فواتير بيع العملاء وخصم أرصدة المستودع — لعرض سجل الفواتير السابقة انتقل لقسم (سجل فواتير المبيعات) من القائمة" 
                           FontSize="12" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButtonStyle}" 
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,10,0"
                        Height="34">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                              Fill="{StaticResource TextSecondaryBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="تحديث" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButtonStyle}" 
                        Command="{Binding ClearInvoiceCommand}"
                        Height="34"
                        Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" 
                              Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                        <TextBlock Text="فاتورة بيع جديدة" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 1. كروت بيانات العميل وإضافة الصنف -->
        <StackPanel Grid.Row="1">
            <!-- كرت بيانات ترويسة الفاتورة والعميل -->
            <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- بيانات الفاتورة والحالة والتاريخ -->
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="16" />
                        <!-- اسم العميل -->
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <!-- هاتف العميل -->
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="12" />
                        <!-- طريقة الدفع -->
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <!-- بيانات رقم الفاتورة والحالة والتاريخ -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#ECFDF5" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding InvoiceNumber}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SalesGreenBrush}" FontFamily="Consolas" />
                        </Border>
                        <Border CornerRadius="6" Padding="8,4" Background="#F1F5F9" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold" Foreground="{Binding StatusColor}" />
                        </Border>
                        <DatePicker SelectedDate="{Binding InvoiceDate}" 
                                    IsEnabled="{Binding CanEditInvoice}"
                                    Height="34" Width="130"
                                    VerticalContentAlignment="Center" 
                                    FontFamily="{StaticResource AppFontFamily}" />
                    </StackPanel>

                    <!-- اسم العميل -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="اسم العميل / الورشة *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 IsEnabled="{Binding CanEditInvoice}"
                                 Height="34" />
                    </StackPanel>

                    <!-- هاتف العميل -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="رقم الهاتف (اختياري)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 IsEnabled="{Binding CanEditInvoice}"
                                 Height="34" />
                    </StackPanel>

                    <!-- طريقة الدفع -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="طريقة الدفع *" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding PaymentMethodsList}" 
                                  SelectedItem="{Binding PaymentMethod}"
                                  IsEnabled="{Binding CanEditInvoice}"
                                  Height="34" 
                                  FontFamily="{StaticResource AppFontFamily}" 
                                  FontSize="12" 
                                  VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- كرت إضافة صنف إلى فاتورة البيع -->
            <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,8" Padding="14,10" IsEnabled="{Binding CanEditInvoice}">
                <StackPanel>
                    <!-- 1. شريط مسح الباركود السريع والاقتراحات التفاعلية الحية -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M2 4h2v16H2V4zm4 0h1v16H6V4zm3 0h2v16H9V4zm4 0h1v16h-1V4zm3 0h2v16h-2V4zm4 0h2v16h-2V4z" 
                                      Fill="{StaticResource PrimaryBlueBrush}" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="مسح الباركود:" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <TextBox x:Name="BarcodeTextBox"
                                         Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                         Height="34"
                                         FontFamily="Consolas, Segoe UI"
                                         FontSize="13"
                                         FontWeight="Bold"
                                         Padding="10,0"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource StandardTextBoxStyle}"
                                         PreviewKeyDown="BarcodeTextBox_PreviewKeyDown">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding AddItemByBarcodeCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>

                                <!-- قائمة الاقتراحات التفاعلية الحية للباركود -->
                                <Popup x:Name="BarcodeSuggestionsPopup"
                                       PlacementTarget="{Binding ElementName=BarcodeTextBox}"
                                       Placement="Bottom"
                                       IsOpen="{Binding IsBarcodePopupOpen, Mode=TwoWay}"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade"
                                       Focusable="False">
                                    <Border Width="{Binding ActualWidth, ElementName=BarcodeTextBox}"
                                            MinWidth="440"
                                            MaxHeight="340"
                                            Background="#FFFFFF"
                                            BorderBrush="#CBD5E1"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,4,0,0"
                                            FlowDirection="RightToLeft"
                                            TextElement.FontFamily="{StaticResource AppFontFamily}"
                                            Focusable="False">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="12" ShadowDepth="4" Direction="270" />
                                        </Border.Effect>
                                        <Grid Focusable="False">
                                            <!-- حالة التحميل -->
                                            <Border Visibility="{Binding IsLoadingBarcodeSuggestions, Converter={StaticResource BoolToVisConverter}}"
                                                    Padding="14,12" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⏳" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="جارٍ البحث عن الأصناف المطابقة..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- حالة عدم وجود نتائج -->
                                            <Border Visibility="{Binding ShowNoBarcodeSuggestions, Converter={StaticResource BoolToVisConverter}}"
                                                    Padding="14,12" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="لا توجد نتائج مطابقة للباركود" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- قائمة الاقتراحات المطابقة -->
                                            <ListBox x:Name="BarcodeSuggestionsListBox"
                                                     ItemsSource="{Binding BarcodeSuggestions}"
                                                     SelectedItem="{Binding SelectedBarcodeSuggestion, Mode=TwoWay}"
                                                     SelectionMode="Single"
                                                     Focusable="False"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                     MaxHeight="310">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,2" />
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="BorderThickness" Value="0" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="ItemBorder"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="#E2E8F0"
                                                                            BorderThickness="0,0,0,1"
                                                                            CornerRadius="6"
                                                                            Padding="10,8"
                                                                            Cursor="Hand">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF" />
                                                                            <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#3B82F6" />
                                                                            <Setter TargetName="ItemBorder" Property="BorderThickness" Value="0,0,3,1" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid PreviewMouseLeftButtonUp="BarcodeSuggestionItem_PreviewMouseLeftButtonUp" Background="Transparent">
                                                            <Grid.Style>
                                                                <Style TargetType="Grid">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.6" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Grid.Style>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding Name}" 
                                                                           FontSize="13" FontWeight="Bold" 
                                                                           Foreground="{StaticResource TextPrimaryBrush}" 
                                                                           TextTrimming="CharacterEllipsis" />

                                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Path Data="M2 4h2v16H2V4zm4 0h1v16H6V4zm3 0h2v16H9V4zm4 0h1v16h-1V4zm3 0h2v16h-2V4zm4 0h2v16h-2V4z" 
                                                                                  Fill="#64748B" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                                            <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <TextBlock Text="{Binding CompatibleVehicles}" 
                                                                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" 
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:N2} ج.م'}" 
                                                                           FontSize="13" FontWeight="Bold" 
                                                                           Foreground="{StaticResource SalesGreenBrush}" 
                                                                           HorizontalAlignment="Left" />

                                                                <Border CornerRadius="4" Padding="6,2" Margin="0,4,0,0" HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="#ECFDF5" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                                    <Setter Property="Background" Value="#FEF2F2" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock FontSize="10" FontWeight="Bold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#059669" />
                                                                                <Setter Property="Text" Value="{Binding Quantity, StringFormat='المتوفر: {0}'}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#DC2626" />
                                                                                        <Setter Property="Text" Value="نفد المخزون (0)" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </Border>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>

                            <!-- زر الإضافة بالباركود -->
                            <Button Grid.Column="3"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding AddItemByBarcodeCommand}"
                                    Height="34" Padding="12,0"
                                    ToolTip="إضافة الصنف المطابق للباركود إلى الفاتورة (أو اضغط Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="إضافة بالباركود" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>

                            <!-- تلميح مساعدة -->
                            <Border Grid.Column="5" Background="#EFF6FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                <TextBlock Text="يدعم قارئ الباركود USB بمفتاح Enter تلقائياً" FontSize="11" Foreground="#1E40AF" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 2. الاختيار اليدوي للصنف والكمية وسعر البيع -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.5*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- الصنف -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="قطعة الغيار (كود OEM / الاسم)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding FilteredAvailableProducts}"
                                      SelectedItem="{Binding SelectedProductToAdd}"
                                      Height="34"
                                      VerticalContentAlignment="Center"
                                      FontFamily="{StaticResource AppFontFamily}"
                                      FontSize="12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding PartNumber}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Border Background="#ECFDF5" CornerRadius="4" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Quantity, StringFormat='المتوفر: {0}'}" FontSize="10" FontWeight="Bold" Foreground="#059669" />
                                            </Border>
                                            <TextBlock Text="{Binding CompatibleVehicles, StringFormat='({0})'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- الكمية -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="الكمية *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding InputQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource StandardTextBoxStyle}" 
                                     Height="34"
                                     FontWeight="Bold" 
                                     HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <!-- سعر البيع للوحدة -->
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="سعر البيع (ج.م) *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding InputUnitPrice, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource StandardTextBoxStyle}" 
                                     Height="34"
                                     FontWeight="Bold" 
                                     HorizontalContentAlignment="Center" />
                        </StackPanel>

                        <!-- زر الإضافة -->
                        <Button Grid.Column="6" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Command="{Binding AddItemCommand}"
                                Height="34" Padding="14,0" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                <TextBlock Text="إضافة للفاتورة" VerticalAlignment="Center" FontSize="12" />
                            </StackPanel>
                        </Button>

                        <!-- نص الرصيد المتاح -->
                        <Border Grid.Column="8" VerticalAlignment="Bottom" Margin="0,0,0,6">
                            <TextBlock Text="{Binding AvailableStockText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}" />
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 2. المساحة المهيمنة الكبرى: كرت جدول بنود فاتورة البيع الحالية -->
        <Border Grid.Row="2" Style="{StaticResource ContentPanelCardStyle}" Padding="0" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- شريط عنوان الجدول وعدد الأصناف والتلميح -->
                <Border Grid.Row="0" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="أصناف وبنود الفاتورة الحالية" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="#ECFDF5" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="{Binding CurrentInvoiceItems.Count, StringFormat='{}{0} أصناف'}" 
                                           FontSize="11" FontWeight="Bold" Foreground="{StaticResource SalesGreenBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="الكمية قابلة للتعديل مباشرة في الجدول وتُحدَّث الإجماليات تلقائياً" 
                                   HorizontalAlignment="Right" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- جدول البنود المتمدد عمودياً داخل المساحة المهيمنة مع تمرير داخلي -->
                <DataGrid Grid.Row="1" 
                          Style="{StaticResource CleanDataGridStyle}" 
                          ItemsSource="{Binding CurrentInvoiceItems}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <!-- كود OEM -->
                        <DataGridTemplateColumn Header="كود OEM" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PartNumber}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#334155" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الباركود -->
                        <DataGridTemplateColumn Header="الباركود" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Barcode}" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#475569" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- اسم الصنف / القطعة -->
                        <DataGridTemplateColumn Header="اسم الصنف / القطعة" Width="2.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductName}" 
                                               FontWeight="SemiBold" 
                                               FontSize="13" 
                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding ProductName}" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- سعر البيع للوحدة -->
                        <DataGridTemplateColumn Header="سعر البيع" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N2} ج.م'}" 
                                               FontSize="12" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- الكمية المباعة (قابلة للتعديل مباشرة في الجدول) -->
                        <DataGridTemplateColumn Header="الكمية" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource StandardTextBoxStyle}" 
                                             Height="28" 
                                             FontWeight="Bold" 
                                             FontSize="12" 
                                             HorizontalContentAlignment="Center" 
                                             VerticalContentAlignment="Center" 
                                             IsEnabled="{Binding DataContext.CanEditInvoice, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             ToolTip="{Binding AvailableQuantity, StringFormat='المتاح بالمستودع: {0}'}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- إجمالي البند -->
                        <DataGridTemplateColumn Header="الإجمالي" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TotalPrice, StringFormat='{}{0:N2} ج.م'}" 
                                               FontWeight="Bold" 
                                               FontSize="13" 
                                               Foreground="{StaticResource SalesGreenBrush}" 
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- حذف البند -->
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource TableRowActionButtonStyle}" 
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Foreground="#DC2626"
                                            ToolTip="حذف هذا الصنف من الفاتورة"
                                            IsEnabled="{Binding DataContext.CanEditInvoice, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <TextBlock Text="✕" FontWeight="Bold" FontSize="13" />
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 3. الشريط السفلي الثابت (الملخص المالي، الملاحظات، أزرار الاعتماد وشريط الحالة) -->
        <StackPanel Grid.Row="3">
            <Border Style="{StaticResource ContentPanelCardStyle}" Background="#F8FAFC" Padding="16,12" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- ملاحظات الفاتورة والدفع -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <!-- الملخص المالي والأزرار -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- الجانب الأيمن: ملاحظات الفاتورة ومبالغ السداد -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ملاحظات اختيارية عن الفاتورة أو شروط البيع:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource StandardTextBoxStyle}" 
                                 IsEnabled="{Binding CanEditInvoice}"
                                 Height="32" Margin="0,0,0,8" />

                        <!-- مبالغ الدفع والمتبقي في الآجل والشبكة -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المبلغ المدفوع (ج.م):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource StandardTextBoxStyle}" 
                                         IsEnabled="{Binding CanEditInvoice}"
                                         Height="32" FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="المتبقي (آجل):" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <Border Background="#F1F5F9" CornerRadius="6" Height="32" Padding="10,0">
                                    <TextBlock Text="{Binding RemainingAmount, StringFormat='{}{0:N2} ج.م'}" 
                                               FontWeight="Bold" FontSize="13" Foreground="#B91C1C" VerticalAlignment="Center" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- الجانب الأيسر: الإجماليات المالية وأزرار الإجراءات -->
                    <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- تفاصيل الحسابات: الإجمالي، الخصم، الصافي -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="إجمالي البنود:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat='{}{0:N2} ج.م'}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الخصم (ج.م):" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBox Grid.Column="1" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource StandardTextBoxStyle}" 
                                     IsEnabled="{Binding CanEditInvoice}"
                                     HorizontalContentAlignment="Right" Height="26" FontWeight="SemiBold" />
                        </Grid>

                        <!-- الصافي النهائي -->
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="0,4,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="صافي الفاتورة:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} ج.م'}" 
                                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource SalesGreenBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- أزرار الإجراءات -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource OutlineButtonStyle}" 
                                    Command="{Binding ClearInvoiceCommand}"
                                    ToolTip="مسح بنود الفاتورة الحالية وتصفير الحقول للبدء من جديد"
                                    Width="110" Height="34"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                          Fill="{StaticResource PrimaryBlueBrush}" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="مسح الفاتورة" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerButtonStyle}" 
                                    Command="{Binding CancelInvoiceCommand}"
                                    IsEnabled="{Binding CanCancelInvoice}"
                                    Width="115" Height="34"
                                    Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" 
                                          Fill="#FFFFFF" Width="11" Height="11" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="إلغاء الفاتورة" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource OutlineButtonStyle}" 
                                    Command="{Binding SaveDraftCommand}"
                                    IsEnabled="{Binding CanEditInvoice}"
                                    Content="حفظ كمسودة" 
                                    Width="105" Height="34"
                                    FontSize="12"
                                    Margin="0,0,8,0" />

                            <Button Style="{StaticResource PrimaryButtonStyle}" 
                                    Command="{Binding PostInvoiceCommand}"
                                    IsEnabled="{Binding CanEditInvoice}"
                                    Background="{StaticResource SalesGreenBrush}"
                                    Width="160" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" />
                                    <TextBlock Text="اعتماد وخصم المخزون" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- شريط الحالة (Status Banner) -->
            <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10,6">
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#065F46" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
