<Window x:Class="CarPartManager.Views.CancelExpenseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:CancelExpenseDialogViewModel}"
        Title="{Binding DialogTitle}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Border Background="{StaticResource ContentBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ترويسة -->
            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FEF2F2" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                              Fill="{StaticResource AlertRedBrush}" Width="20" Height="20" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding HeaderHint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- بيانات المصروف + سبب الإلغاء -->
            <Border Grid.Row="1" Padding="24,16">
                <StackPanel>
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <TextBlock Text="{Binding ExpenseSummary}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="سبب الإلغاء *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StandardTextBoxStyle}"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </Border>

            <!-- شريط الخطأ -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="24,0,24,10"
                    Padding="12,10">
                <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" TextWrapping="Wrap" />
            </Border>

            <!-- أزرار -->
            <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource OutlineButtonStyle}"
                            Command="{Binding CancelCommand}"
                            Content="رجوع"
                            Width="100"
                            Margin="0,0,10,0" />

                    <Button Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanSave}"
                            Content="تأكيد الإلغاء"
                            Width="140" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
