<UserControl x:Class="CarPartManager.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ReturnsViewModel}"
             d:DesignHeight="950" d:DesignWidth="1250"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <x:Array x:Key="ItemConditionOptions" Type="sys:String">
            <sys:String>إرجاع إلى المخزون المتاح للبيع</sys:String>
            <sys:String>إرجاع إلى مخزون التالف</sys:String>
            <sys:String>استبعاد نهائي من المخزون</sys:String>
        </x:Array>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <!-- 1. ترويسة الشاشة -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="إدارة المرتجعات (المبيعات والمشتريات)" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="معالجة مرتجعات العملاء والموردين، التحقق من حدود الكميات وأرصدة المخزون، وتسجيل الحركات المعكوسة بدقة" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButtonStyle}" 
                            Command="{Binding RefreshAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{StaticResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="تحديث البيانات" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. أزرار التبديل بين مرتجعات المبيعات ومرتجعات المشتريات -->
            <Border Background="#F1F5F9" CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding ShowSalesTabCommand}"
                            Padding="22,9"
                            Cursor="Hand"
                            BorderThickness="0"
                            Margin="2,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSalesTab}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="مرتجعات المبيعات (من العملاء)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding ShowPurchasesTabCommand}"
                            Padding="22,9"
                            Cursor="Hand"
                            BorderThickness="0"
                            Margin="2,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPurchasesTab}" Value="True">
                                        <Setter Property="Background" Value="#7C3AED" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                  Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="مرتجعات المشتريات (إلى الموردين)" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <TabControl SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="Transparent">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.ItemContainerStyle>

                <!-- ==================== التبويب الأول: مرتجعات المبيعات ==================== -->
                <TabItem Header="SalesReturn">
                    <StackPanel>
                        <!-- كرت اختيار فاتورة المبيعات الأصلية -->
                        <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#DBEAFE" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                            <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" 
                                                  Fill="#1D4ED8" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="1. تحديد فاتورة المبيعات الأصلية" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#FEF3C7" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="يسمح فقط بإرجاع فواتير البيع المعتمدة" FontSize="11" Foreground="#B45309" FontWeight="Medium" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- اختيار الفاتورة -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="اختر فاتورة البيع المعتمدة *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding EligibleSalesInvoices}"
                                                  SelectedItem="{Binding SelectedSalesInvoice, Mode=TwoWay}"
                                                  Height="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="#1E293B" Width="120" />
                                                        <TextBlock Text=" | العميل: " Foreground="#64748B" />
                                                        <TextBlock Text="{Binding CustomerName}" Foreground="#0F172A" Width="150" />
                                                        <TextBlock Text=" | التاريخ: " Foreground="#64748B" />
                                                        <TextBlock Text="{Binding InvoiceDate, StringFormat='yyyy/MM/dd'}" Foreground="#334155" Width="90" />
                                                        <TextBlock Text=" | الإجمالي: " Foreground="#64748B" />
                                                        <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" Foreground="#059669" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- رقم المرتجع التلقائي -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="رقم إذن المرتجع" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding SalesReturnNumber}" IsReadOnly="True" Background="#F8FAFC" Style="{StaticResource StandardTextBoxStyle}" FontWeight="Bold" Foreground="#1E3A8A" />
                                    </StackPanel>

                                    <!-- سبب المرتجع -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="سبب المرتجع *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox SelectedValue="{Binding SalesReturnReason, Mode=TwoWay}" SelectedValuePath="Content" Height="38">
                                            <ComboBoxItem Content="عيب في القطعة" IsSelected="True" />
                                            <ComboBoxItem Content="طلب بالخطأ من العميل" />
                                            <ComboBoxItem Content="غير مطابق لموديل السيارة" />
                                            <ComboBoxItem Content="تالف عند الاستلام" />
                                            <ComboBoxItem Content="أخرى" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- حقل الملاحظات -->
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="ملاحظات إضافية على المرتجع (اختياري)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding SalesReturnNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Height="36" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- كرت جدول بنود الفاتورة والكميات المراد إرجاعها -->
                        <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2. بنود الفاتورة الأصلية وتحديد الكميات ومصير القطع" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="مصير المرتجع: متاح للبيع (يزيد الرصيد المتاح) • مخزون التالف (يحتفظ به كتالف) • استبعاد نهائي (يوثق ولا يضاف)" FontSize="11" Foreground="#475569" FontStyle="Italic" VerticalAlignment="Center" />
                                </Grid>

                                <DataGrid ItemsSource="{Binding SalesDraftItems}"
                                          Style="{StaticResource CleanDataGridStyle}"
                                          MaxHeight="320">
                                    <DataGrid.Columns>
                                        <!-- كود القطعة -->
                                        <DataGridTextColumn Header="كود القطعة" Binding="{Binding PartNumber}" Width="120" IsReadOnly="True" />

                                        <!-- اسم الصنف -->
                                        <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2.2*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- الكمية المباعة -->
                                        <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding OriginalQuantity}" Width="95" IsReadOnly="True" />

                                        <!-- المرتجع سابقاً -->
                                        <DataGridTextColumn Header="المرتجع سابقاً" Binding="{Binding AlreadyReturnedQuantity}" Width="105" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- المتبقي القابل للإرجاع -->
                                        <DataGridTextColumn Header="المتبقي للإرجاع" Binding="{Binding MaxReturnableQuantity}" Width="115" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- سعر البيع -->
                                        <DataGridTextColumn Header="سعر البيع" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ج.م'}" Width="110" IsReadOnly="True" />

                                        <!-- الكمية المرتجعة (تعديل) -->
                                        <DataGridTemplateColumn Header="الكمية المرتجعة" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontWeight="Bold" 
                                                             FontSize="13"
                                                             TextAlignment="Center" 
                                                             Height="30" 
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#3B82F6" 
                                                             BorderThickness="1.5" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- مصير وحالة القطعة المرتجعة -->
                                        <DataGridTemplateColumn Header="مصير القطعة المرتجعة" Width="215">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{StaticResource ItemConditionOptions}"
                                                              SelectedItem="{Binding Condition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Height="30"
                                                              FontSize="11"
                                                              VerticalContentAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- الإجمالي الفرعي -->
                                        <DataGridTextColumn Header="إجمالي السطر" Binding="{Binding LineTotal, StringFormat='{}{0:N2} ج.م'}" Width="120" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#1E40AF" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- شريط الإجمالي واعتماد المرتجع -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="إجمالي قيمة المرتجع المستحقة للعميل:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding SalesReturnTotalAmount, StringFormat='{}{0:N2} ج.م'}" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource OutlineButtonStyle}" 
                                                    Command="{Binding ClearSalesReturnCommand}" 
                                                    Content="تفريغ الحقول" 
                                                    Margin="0,0,10,0" 
                                                    Padding="16,0" />

                                            <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                    Command="{Binding PostSalesReturnCommand}"
                                                    Background="#2563EB"
                                                    Padding="20,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" 
                                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                                    <TextBlock Text="اعتماد مرتجع المبيعات وتحديث المخزون" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- كرت سجل مرتجعات المبيعات السابقة (الأرشيف) -->
                        <Border Style="{StaticResource ContentPanelCardStyle}">
                            <StackPanel>
                                <TextBlock Text="سجل مرتجعات المبيعات المعتمدة السابقة" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <DataGrid ItemsSource="{Binding SalesReturnsHistory}"
                                          Style="{StaticResource CleanDataGridStyle}"
                                          MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding SalesInvoice.InvoiceNumber}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="اسم العميل" Binding="{Binding SalesInvoice.CustomerName}" Width="1.8*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="تاريخ المرتجع" Binding="{Binding ReturnDate, StringFormat='yyyy/MM/dd hh:mm tt'}" Width="150" IsReadOnly="True" />
                                        <DataGridTextColumn Header="سبب المرتجع" Binding="{Binding Reason}" Width="1.4*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="إجمالي القيمة" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" Width="120" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <!-- ==================== التبويب الثاني: مرتجعات المشتريات ==================== -->
                <TabItem Header="PurchaseReturn">
                    <StackPanel>
                        <!-- كرت اختيار فاتورة المشتريات الأصلية -->
                        <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="#EDE9FE" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                                            <Path Data="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" 
                                                  Fill="#7C3AED" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="1. تحديد فاتورة المشتريات الأصلية" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#FEE2E2" CornerRadius="6" Padding="10,4">
                                        <TextBlock Text="يتحقق النظام من كفاية المخزون ويرفض المرتجع إذا كان الرصيد غير كافٍ" FontSize="11" Foreground="#B91C1C" FontWeight="Medium" />
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- اختيار الفاتورة -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="اختر فاتورة المشتريات المعتمدة *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox ItemsSource="{Binding EligiblePurchaseInvoices}"
                                                  SelectedItem="{Binding SelectedPurchaseInvoice, Mode=TwoWay}"
                                                  Height="38">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding InvoiceNumber}" FontWeight="Bold" Foreground="#1E293B" Width="120" />
                                                        <TextBlock Text=" | المورد: " Foreground="#64748B" />
                                                        <TextBlock Text="{Binding SupplierName}" Foreground="#0F172A" Width="150" />
                                                        <TextBlock Text=" | التاريخ: " Foreground="#64748B" />
                                                        <TextBlock Text="{Binding InvoiceDate, StringFormat='yyyy/MM/dd'}" Foreground="#334155" Width="90" />
                                                        <TextBlock Text=" | الإجمالي: " Foreground="#64748B" />
                                                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" FontWeight="Bold" Foreground="#7C3AED" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- رقم المرتجع التلقائي -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="رقم إذن مرتجع الشراء" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding PurchaseReturnNumber}" IsReadOnly="True" Background="#F8FAFC" Style="{StaticResource StandardTextBoxStyle}" FontWeight="Bold" Foreground="#6D28D9" />
                                    </StackPanel>

                                    <!-- سبب المرتجع للمورد -->
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="سبب المرتجع للمورد *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox SelectedValue="{Binding PurchaseReturnReason, Mode=TwoWay}" SelectedValuePath="Content" Height="38">
                                            <ComboBoxItem Content="غير مطابق للمواصفات" IsSelected="True" />
                                            <ComboBoxItem Content="عيب مصنعي" />
                                            <ComboBoxItem Content="زيادة في الكمية الموردة" />
                                            <ComboBoxItem Content="تلف ناتج عن الشحن والتوريد" />
                                            <ComboBoxItem Content="أخرى" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- حقل الملاحظات -->
                                <StackPanel Margin="0,4,0,0">
                                    <TextBlock Text="ملاحظات إضافية (اختياري)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding PurchaseReturnNotes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource StandardTextBoxStyle}" Height="36" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- كرت بنود فاتورة الشراء وتحديد الكميات -->
                        <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="2. بنود فاتورة الشراء وفحص رصيد المستودع الحالي" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="يتم التحقق تلقائياً من توفر رصيد كافٍ في المخزون لمنع حدوث رصيد سالب" FontSize="11" Foreground="#DC2626" FontStyle="Italic" VerticalAlignment="Center" />
                                </Grid>

                                <DataGrid ItemsSource="{Binding PurchaseDraftItems}"
                                          Style="{StaticResource CleanDataGridStyle}"
                                          MaxHeight="320">
                                    <DataGrid.Columns>
                                        <!-- كود القطعة -->
                                        <DataGridTextColumn Header="كود القطعة" Binding="{Binding PartNumber}" Width="120" IsReadOnly="True" />

                                        <!-- اسم الصنف -->
                                        <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2.2*" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- الكمية المشتراة -->
                                        <DataGridTextColumn Header="الكمية المشتراة" Binding="{Binding OriginalQuantity}" Width="95" IsReadOnly="True" />

                                        <!-- المرتجع سابقاً -->
                                        <DataGridTextColumn Header="المرتجع سابقاً" Binding="{Binding AlreadyReturnedQuantity}" Width="105" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#D97706" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- المتبقي القابل للإرجاع -->
                                        <DataGridTextColumn Header="المتبقي للإرجاع" Binding="{Binding MaxReturnableQuantity}" Width="115" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- الرصيد الحالي بالمخزون -->
                                        <DataGridTextColumn Header="المتاح بالمخزون" Binding="{Binding CurrentStockQuantity}" Width="115" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <!-- سعر الشراء الأصلي -->
                                        <DataGridTextColumn Header="سعر الشراء" Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ج.م'}" Width="110" IsReadOnly="True" />

                                        <!-- الكمية المرتجعة للمورد -->
                                        <DataGridTemplateColumn Header="الكمية المرتجعة" Width="125">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBox Text="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged}" 
                                                             FontWeight="Bold" 
                                                             FontSize="13"
                                                             TextAlignment="Center" 
                                                             Height="30" 
                                                             VerticalContentAlignment="Center"
                                                             BorderBrush="#7C3AED" 
                                                             BorderThickness="1.5" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- الإجمالي الفرعي -->
                                        <DataGridTextColumn Header="إجمالي السطر" Binding="{Binding LineTotal, StringFormat='{}{0:N2} ج.م'}" Width="120" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#7C3AED" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- شريط الإجمالي واعتماد المرتجع -->
                                <Border Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="إجمالي قيمة المرتجع للمورد:" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding PurchaseReturnTotalAmount, StringFormat='{}{0:N2} ج.م'}" FontSize="18" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource OutlineButtonStyle}" 
                                                    Command="{Binding ClearPurchaseReturnCommand}" 
                                                    Content="تفريغ الحقول" 
                                                    Margin="0,0,10,0" 
                                                    Padding="16,0" />

                                            <Button Style="{StaticResource PrimaryButtonStyle}" 
                                                    Command="{Binding PostPurchaseReturnCommand}"
                                                    Background="#7C3AED"
                                                    Padding="20,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z" 
                                                          Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                                    <TextBlock Text="اعتماد مرتجع الشراء وخصم المخزون" FontWeight="Bold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- كرت سجل مرتجعات المشتريات السابقة (الأرشيف) -->
                        <Border Style="{StaticResource ContentPanelCardStyle}">
                            <StackPanel>
                                <TextBlock Text="سجل مرتجعات المشتريات المعتمدة السابقة" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                                <DataGrid ItemsSource="{Binding PurchaseReturnsHistory}"
                                          Style="{StaticResource CleanDataGridStyle}"
                                          MaxHeight="260">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding PurchaseInvoice.InvoiceNumber}" Width="120" IsReadOnly="True" />
                                        <DataGridTextColumn Header="اسم المورد" Binding="{Binding PurchaseInvoice.SupplierName}" Width="1.8*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="تاريخ المرتجع" Binding="{Binding ReturnDate, StringFormat='yyyy/MM/dd hh:mm tt'}" Width="150" IsReadOnly="True" />
                                        <DataGridTextColumn Header="سبب المرتجع" Binding="{Binding Reason}" Width="1.4*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="إجمالي القيمة" Binding="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" Width="120" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                    <Setter Property="Foreground" Value="#7C3AED" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="90" IsReadOnly="True">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Foreground" Value="#059669" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
