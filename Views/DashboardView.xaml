<UserControl x:Class="CarPartManager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:DashboardViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32">

            <!-- رأس لوحة التحكم (Dashboard Header) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="نظرة عامة على المتجر" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="متابعة حركة المشتريات والتوريد اليومية، فواتير الموردين، وتنبيهات نواقص قطع الغيار في المستودع" 
                               FontSize="13" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               Margin="0,4,0,0" />
                </StackPanel>

                <!-- أزرار الإجراءات السريعة في الهيدر -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource OutlineButtonStyle}" 
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"
                                  Fill="{StaticResource TextSecondaryBrush}"
                                  Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="تحديث البيانات" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Background="#E0E7FF" CornerRadius="8" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#4F46E5" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="نظام التنبيهات المباشر نشط" FontSize="12" FontWeight="SemiBold" Foreground="#3730A3" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- كروت الإحصائيات الأربعة (Dashboard Stat Cards) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- بطاقة 1: قيمة المبيعات المعتمدة اليوم -->
                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="إجمالي مبيعات اليوم" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource SalesGreenLightBrush}" CornerRadius="6" Width="36" Height="36">
                                <Path Data="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"
                                      Fill="{StaticResource SalesGreenBrush}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding TodaySalesAmount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,6" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Border Background="#DEF7EC" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock Text="معتمد" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SalesGreenBrush}" />
                            </Border>
                            <TextBlock Text="{Binding TodaySalesSubtext}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- بطاقة 2: عدد فواتير اليوم (بيع وشراء) -->
                <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="حركة فواتير اليوم" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource InvoicesIndigoLightBrush}" CornerRadius="6" Width="36" Height="36">
                                <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-5 14H7v-2h7v2zm3-4H7v-2h10v2zm0-4H7V7h10v2z"
                                      Fill="{StaticResource InvoicesIndigoBrush}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding InvoiceCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,6" />

                        <TextBlock Grid.Row="2" Text="{Binding InvoiceCountSubtext}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- بطاقة 3: إجمالي الأصناف وقطع الغيار -->
                <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="أصناف قطع الغيار المسجلة" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource ProductsTealLightBrush}" CornerRadius="6" Width="36" Height="36">
                                <Path Data="M20 7l-8-4-8 4 8 4 8-4zm-8 6l-8-4v8l8 4 8-4v-8l-8 4z"
                                      Fill="{StaticResource ProductsTealBrush}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding ProductCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,10,0,6" />

                        <TextBlock Grid.Row="2" Text="{Binding ProductCountSubtext}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Border>

                <!-- بطاقة 4: تنبيهات نقص المخزون -->
                <Border Grid.Column="6" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="تنبيهات نقص المخزون" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border HorizontalAlignment="Right" Background="{StaticResource AlertRedLightBrush}" CornerRadius="6" Width="36" Height="36">
                                <Path Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"
                                      Fill="{StaticResource AlertRedBrush}" Width="18" Height="18" Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding LowStockCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AlertRedBrush}" Margin="0,10,0,6" />

                        <TextBlock Grid.Row="2" Text="{Binding LowStockSubtext}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- محتوى لوحة التحكم السفلي (جدول النواقص + قائمة آخر الفواتير) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.8*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1.7*" />
                </Grid.ColumnDefinitions>

                <!-- الجزء الأيمن: جدول قطع الغيار التي أوشكت على النفاد -->
                <Border Grid.Column="0" Style="{StaticResource ContentPanelCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="قطع الغيار الواجب إعادة طلبها (النواقص الحرجة)" 
                                           FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock Text="قائمة الأصناف التي وصلت لكميات أقل من حد الأمان المحدد في المستودع" 
                                           FontSize="12" 
                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                <TextBlock Text="تنبيه مخزن" FontSize="11" FontWeight="Bold" Foreground="#B91C1C" />
                            </Border>
                        </Grid>

                        <DataGrid Style="{StaticResource CleanDataGridStyle}" 
                                  ItemsSource="{Binding LowStockItems}">
                            <DataGrid.Columns>
                                <!-- رقم OEM / الكود -->
                                <DataGridTemplateColumn Header="كود القطعة (OEM)" Width="125">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="#F1F5F9" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding PartNumber}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="SemiBold" Foreground="#334155" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- اسم القطعة -->
                                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding PartName}" Width="*" FontWeight="SemiBold" />

                                <!-- التوافق مع السيارات -->
                                <DataGridTextColumn Header="السيارات المتوافقة" Binding="{Binding VehicleModel}" Width="160" Foreground="{StaticResource TextSecondaryBrush}" />

                                <!-- الكمية الحالية -->
                                <DataGridTemplateColumn Header="المتوفر" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CurrentStock}" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- حد الطلب -->
                                <DataGridTemplateColumn Header="حد الطلب" Width="75">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding MinimumRequired}" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- السعر -->
                                <DataGridTemplateColumn Header="سعر الوحدة" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat='{}{0:N0} ج.م'}" Foreground="{StaticResource TextPrimaryBrush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- درجة الحرج -->
                                <DataGridTemplateColumn Header="الحالة" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" Background="#FEF2F2">
                                                <TextBlock Text="{Binding UrgencyText}" FontSize="11" FontWeight="Bold" Foreground="{Binding UrgencyColor}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- الجزء الأيسر: سجل آخر الفواتير والإجراءات السريعة -->
                <StackPanel Grid.Column="2">
                    
                    <!-- كرت آخر العمليات -->
                    <Border Style="{StaticResource ContentPanelCardStyle}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="آخر الفواتير الصادرة والواردة" 
                                       FontSize="15" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       Margin="0,0,0,14" />

                            <ItemsControl ItemsSource="{Binding RecentInvoices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding PartyName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding InvoiceCode}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" Margin="0,0,6,0" />
                                                        <TextBlock Text="•" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding TimeFormatted}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:N2} ج.م'}" 
                                                               FontWeight="Bold" 
                                                               FontSize="13" 
                                                               Foreground="{StaticResource TextPrimaryBrush}" 
                                                               HorizontalAlignment="Right" />
                                                    <Border CornerRadius="4" Padding="5,1" Margin="0,3,0,0" HorizontalAlignment="Right" Background="#F1F5F9">
                                                        <TextBlock Text="{Binding PaymentMethod}" FontSize="10" FontWeight="SemiBold" Foreground="#475569" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- صندوق أدوات سريعة لمحل قطع الغيار -->
                    <Border Style="{StaticResource ContentPanelCardStyle}">
                        <StackPanel>
                            <TextBlock Text="معلومات المستودع والفرع" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                       Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="إجمالي قيمة بضاعة المخزون:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding WarehouseInventoryCost}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="فواتير المبيعات الصادرة:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SalesCountText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource SalesGreenBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="فواتير المشتريات الواردة:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding PurchasesCountText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource InvoicesIndigoBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="الموردين والشركات المسجلة:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SuppliersCountText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource PrimaryBlueBrush}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="سجل حركات المخزون:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding InventoryMovementsText}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource TextPrimaryBrush}" />
                            </Grid>

                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,6,0,0">
                                <TextBlock Text="{Binding SystemStatusNote}"
                                           FontSize="11" 
                                           Foreground="#1E40AF" 
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
