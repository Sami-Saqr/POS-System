<Window x:Class="CarPartManager.Views.ExpenseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:CarPartManager.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewmodels:ExpenseDialogViewModel}"
        Title="{Binding DialogTitle}"
        Width="680" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Border Background="{StaticResource ContentBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. ترويسة النافذة -->
            <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="24,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#FEF3C7" CornerRadius="8" Width="40" Height="40" Margin="0,0,12,0">
                        <Path Data="M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                              Fill="{StaticResource WarningAmberBrush}" Width="20" Height="20" Stretch="Uniform" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DialogTitle}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding HeaderHint}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. حقول النموذج -->
            <Border Grid.Row="1" Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- العمود الأيمن -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="تاريخ المصروف" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <DatePicker SelectedDate="{Binding ExpenseDate, UpdateSourceTrigger=PropertyChanged}"
                                    Height="38" Margin="0,0,0,14"
                                    FontFamily="{StaticResource AppFontFamily}" FontSize="13"
                                    FlowDirection="RightToLeft" />

                        <TextBlock Text="تصنيف المصروف *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding Categories}"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedCategoryId, UpdateSourceTrigger=PropertyChanged}"
                                  Height="38" Margin="0,0,0,14"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  FontSize="13"
                                  VerticalContentAlignment="Center" />

                        <TextBlock Text="المبلغ (ج.م) *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 Margin="0,0,0,6" />
                        <TextBlock Text="يجب أن يكون أكبر من صفر — يقبل الأرقام العربية (٠-٩)."
                                   FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,14" TextWrapping="Wrap" />

                        <TextBlock Text="طريقة الدفع" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}"
                                  SelectedItem="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                  Height="38" Margin="0,0,0,14"
                                  FontFamily="{StaticResource AppFontFamily}"
                                  FontSize="13"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>

                    <!-- العمود الأيسر -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الوصف" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="رقم مرجعي (اختياري)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding ReferenceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 Margin="0,0,0,14" />

                        <TextBlock Text="ملاحظات (اختياري)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource StandardTextBoxStyle}"
                                 Height="110"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. شريط الخطأ -->
            <Border Grid.Row="2"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisConverter}}"
                    Background="#FEF2F2"
                    BorderBrush="#FCA5A5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="24,0,24,10"
                    Padding="12,10">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                          Fill="#DC2626" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 4. أزرار الحفظ والإلغاء -->
            <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}" Padding="24,16">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="* الحقول الإجبارية: التصنيف والمبلغ" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding CancelCommand}"
                                Content="إلغاء الأمر"
                                Width="100"
                                Margin="0,0,10,0" />

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}"
                                Content="{Binding SaveButtonText}"
                                Width="140" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
